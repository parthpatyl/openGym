<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="4dp"
    android:paddingStart="2dp"
    android:paddingEnd="2dp">

    <!-- Top Row: Left Title Case Exercise Name + Right Set Badge -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="4dp">

        <TextView
            android:id="@+id/notification_exercise_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Barbell Bench Press"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/notification_set_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Set 3/4"
            android:textColor="#30D158"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <!-- Center: Left-Aligned Large Countdown Clock -->
    <TextView
        android:id="@+id/notification_timer_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="start"
        android:text="1:21"
        android:textColor="#FFFFFF"
        android:textSize="36sp"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_marginBottom="6dp" />

    <!-- Slim Rounded Progress Bar -->
    <ProgressBar
        android:id="@+id/notification_progress_bar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="5dp"
        android:max="100"
        android:progress="100"
        android:progressDrawable="@drawable/progress_bar_accent"
        android:layout_marginBottom="12dp" />

    <!-- Bottom Row: Circular -15 / +15 and Pill Skip Capsule -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Circular -15 Button -->
        <Button
            android:id="@+id/btn_minus_15"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="-15"
            android:textColor="#E5E5EA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_circle"
            android:gravity="center"
            android:padding="0dp"
            android:layout_marginEnd="8dp" />

        <!-- Circular +15 Button -->
        <Button
            android:id="@+id/btn_plus_15"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:text="+15"
            android:textColor="#E5E5EA"
            android:textSize="12sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_circle"
            android:gravity="center"
            android:padding="0dp" />

        <!-- Space to push Skip capsule to the right -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Elongated Pill Skip Capsule -->
        <Button
            android:id="@+id/btn_skip"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="96dp"
            android:text="Skip"
            android:textColor="#000000"
            android:textSize="14sp"
            android:textStyle="bold"
            android:background="@drawable/bg_btn_accent"
            android:paddingStart="24dp"
            android:paddingEnd="24dp" />
    </LinearLayout>

</LinearLayout>
